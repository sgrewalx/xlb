{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlb.codemachine.in/schemas/earthquake-current.schema.json",
  "title": "XLB Earthquake Intelligence Current Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "source", "summary", "baseline", "trends", "events"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "baselineUrl", "window", "baselineWindow"],
      "properties": {
        "name": { "const": "USGS Earthquake Hazards Program" },
        "url": { "type": "string", "format": "uri" },
        "baselineUrl": { "type": "string", "format": "uri" },
        "window": { "const": "past-24-hours" },
        "baselineWindow": { "const": "previous-6-days" }
      }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "dailyAverage", "differenceFromAverage"],
      "properties": {
        "days": { "const": 6 },
        "dailyAverage": { "$ref": "#/$defs/comparison" },
        "differenceFromAverage": { "$ref": "#/$defs/signedComparison" }
      }
    },
    "trends": {
      "type": "object",
      "additionalProperties": false,
      "required": ["magnitudeBands", "threeHourBuckets"],
      "properties": {
        "magnitudeBands": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "count"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "threeHourBuckets": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end", "count"],
            "properties": {
              "start": { "type": "string", "format": "date-time" },
              "end": { "type": "string", "format": "date-time" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "m4Plus", "m5Plus", "shallowCount", "medianDepthKm", "strongestMagnitude", "strongestEventId"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "m4Plus": { "type": "integer", "minimum": 0 },
        "m5Plus": { "type": "integer", "minimum": 0 },
        "shallowCount": { "type": "integer", "minimum": 0 },
        "medianDepthKm": { "type": ["number", "null"] },
        "strongestMagnitude": { "type": ["number", "null"] },
        "strongestEventId": { "type": ["string", "null"] }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "m4Plus", "m5Plus"],
      "properties": {
        "total": { "type": "number", "minimum": 0 },
        "m4Plus": { "type": "number", "minimum": 0 },
        "m5Plus": { "type": "number", "minimum": 0 }
      }
    },
    "signedComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "m4Plus", "m5Plus"],
      "properties": {
        "total": { "type": "number" },
        "m4Plus": { "type": "number" },
        "m5Plus": { "type": "number" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "magnitude", "place", "occurredAt", "updatedAt", "latitude", "longitude", "depthKm", "tsunami", "significance", "felt", "alert", "status", "url"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "magnitude": { "type": "number" },
        "place": { "type": "string", "minLength": 1 },
        "occurredAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "depthKm": { "type": "number" },
        "tsunami": { "type": "boolean" },
        "significance": { "type": ["number", "null"], "minimum": 0 },
        "felt": { "type": ["integer", "null"], "minimum": 0 },
        "alert": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "url": { "type": "string", "format": "uri" }
      }
    }
  }
}
